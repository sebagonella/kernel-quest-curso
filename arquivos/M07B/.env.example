# Copie este arquivo para .env e preencha os valores.
# O .env NUNCA vai para o Git (está no .gitignore).

# Chave gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=cole_sua_chave_aqui

# Modelo de IA do jogo. Flash-Lite: rápido e com raciocínio mínimo, bom para diálogo.
# Lista atual: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite

# Aparece na tela de boas-vindas (primeiro nome ou apelido: nomes longos não cabem).
NOME_ENGENHEIRO=Seu Nome

# Avisos no Discord (opcional, M07B): a URL do webhook de um canal seu.
# É um segredo: quem tem a URL publica no seu canal. Sem ela, o jogo segue sem Discord.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Quanto detalhe o log mostra no terminal: DEBUG, INFO (padrão) ou WARNING.
# NIVEL_LOG=DEBUG
